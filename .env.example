# Never commit a populated .env file.
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_API_BASE=https://www.eventbriteapi.com/v3
EVENTBRITE_OUTPUT_DIR=eventbrite_json
EVENTBRITE_PAGE_SIZE=50
EVENTBRITE_TIMEOUT_SECONDS=30
EVENTBRITE_MAX_RETRIES=5
EVENTBRITE_EVENT_STATUSES=draft,live,started,ended,completed,canceled
EVENTBRITE_FETCH_ATTENDEES=true
EVENTBRITE_FETCH_ORDERS=true
